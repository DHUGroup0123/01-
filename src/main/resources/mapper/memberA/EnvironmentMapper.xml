<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.team_work.memberA.mall.mapper.EnvironmentMapper">
    <select id="schemaVersion" resultType="string">
        SELECT version FROM schema_version WHERE version = 'V001'
    </select>
    <select id="countProducts" resultType="int">SELECT COUNT(*) FROM product</select>
    <select id="countCategories" resultType="int">SELECT COUNT(*) FROM category</select>
    <select id="findPreviewProducts" resultType="com.team.team_work.memberA.mall.dto.ProductPreview">
        SELECT product_id, product_name, summary, selling_price, stock
        FROM product WHERE sell_status = 1 ORDER BY product_id LIMIT 6
    </select>
</mapper>
