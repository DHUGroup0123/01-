<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.team_work.memberA.mall.mapper.EnvironmentMapper">
 <select id="schemaVersion" resultType="string">SELECT 'MALL-01'</select>
 <select id="countProducts" resultType="int">SELECT COUNT(*) FROM tb_mall_goods_info</select>
 <select id="countCategories" resultType="int">SELECT COUNT(*) FROM tb_mall_goods_category</select>
 <select id="findPreviewProducts" resultType="com.team.team_work.memberA.mall.dto.ProductPreview">SELECT goods_id AS product_id,goods_name AS product_name,goods_intro AS summary,selling_price,stock_num AS stock FROM tb_mall_goods_info WHERE goods_sell_status=0 ORDER BY goods_id LIMIT 6</select>
</mapper>
