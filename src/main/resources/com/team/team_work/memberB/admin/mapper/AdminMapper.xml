<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.team_work.memberB.admin.mapper.AdminMapper">
<resultMap id="admin" type="com.team.team_work.memberB.admin.entity.AdminAccount"><result column="admin_user_id" property="adminUserId"/><result column="login_user_name" property="loginUserName"/><result column="login_password" property="loginPassword"/><result column="nick_name" property="nickName"/><result column="locked" property="locked"/><result column="credential_version" property="credentialVersion"/></resultMap>
<resultMap id="member" type="com.team.team_work.memberB.admin.entity.Member"><result column="user_id" property="userId"/><result column="login_name" property="loginName"/><result column="nick_name" property="nickName"/><result column="locked_flag" property="lockedFlag"/><result column="is_deleted" property="isDeleted"/></resultMap>
<resultMap id="carousel" type="com.team.team_work.memberB.admin.entity.Carousel"><result column="carousel_id" property="carouselId"/><result column="carousel_url" property="carouselUrl"/><result column="redirect_url" property="redirectUrl"/><result column="carousel_rank" property="carouselRank"/><result column="is_deleted" property="isDeleted"/></resultMap>
<resultMap id="config" type="com.team.team_work.memberB.admin.entity.HomeConfig"><result column="config_id" property="configId"/><result column="config_name" property="configName"/><result column="config_type" property="configType"/><result column="goods_id" property="goodsId"/><result column="redirect_url" property="redirectUrl"/><result column="config_rank" property="configRank"/><result column="is_deleted" property="isDeleted"/></resultMap>

<select id="byLogin" resultMap="admin">SELECT * FROM tb_newbee_mall_admin_user WHERE login_user_name=#{login}</select>
<select id="byId" resultMap="admin">SELECT * FROM tb_newbee_mall_admin_user WHERE admin_user_id=#{id}</select>
<insert id="insertAdmin" useGeneratedKeys="true" keyProperty="adminUserId">INSERT INTO tb_newbee_mall_admin_user(login_user_name,login_password,nick_name,locked,credential_version) VALUES(#{loginUserName},#{loginPassword},#{nickName},0,0)</insert>
<update id="profile">UPDATE tb_newbee_mall_admin_user SET nick_name=#{nickName} WHERE admin_user_id=#{id}</update>
<update id="password">UPDATE tb_newbee_mall_admin_user SET login_password=#{password},credential_version=credential_version+1 WHERE admin_user_id=#{id}</update>
<select id="guard" resultType="int">SELECT id FROM tb_member_b_guard WHERE id=1 FOR UPDATE</select>
<select id="receipt" resultType="string">SELECT response_body FROM tb_member_b_request WHERE actor_id=#{actor} AND request_key=#{key}</select>
<select id="fingerprint" resultType="string">SELECT fingerprint FROM tb_member_b_request WHERE actor_id=#{actor} AND request_key=#{key}</select>
<insert id="remember">INSERT INTO tb_member_b_request(actor_id,request_key,fingerprint,response_body) VALUES(#{actor},#{key},#{fingerprint},#{result})</insert>
<sql id="whereMembers">WHERE is_deleted=0 <if test="q != null and q != ''">AND (login_name LIKE CONCAT('%',#{q},'%') OR nick_name LIKE CONCAT('%',#{q},'%'))</if></sql>
<select id="members" resultMap="member">SELECT user_id,login_name,nick_name,locked_flag,is_deleted FROM tb_newbee_mall_user <include refid="whereMembers"/> ORDER BY user_id DESC LIMIT #{size} OFFSET #{offset}</select>
<select id="memberCount" resultType="long">SELECT COUNT(*) FROM tb_newbee_mall_user <include refid="whereMembers"/></select>
<select id="member" resultMap="member">SELECT user_id,login_name,nick_name,locked_flag,is_deleted FROM tb_newbee_mall_user WHERE user_id=#{id} AND is_deleted=0</select>
<update id="lockMember">UPDATE tb_newbee_mall_user SET locked_flag=#{locked} WHERE user_id=#{id} AND is_deleted=0</update>
<select id="carousels" resultMap="carousel">SELECT * FROM tb_newbee_mall_carousel ORDER BY carousel_rank DESC,carousel_id</select>
<select id="carousel" resultMap="carousel">SELECT * FROM tb_newbee_mall_carousel WHERE carousel_id=#{id}</select>
<insert id="insertCarousel" useGeneratedKeys="true" keyProperty="carouselId">INSERT INTO tb_newbee_mall_carousel(carousel_url,redirect_url,carousel_rank,is_deleted) VALUES(#{carouselUrl},#{redirectUrl},#{carouselRank},#{isDeleted})</insert>
<update id="updateCarousel">UPDATE tb_newbee_mall_carousel SET carousel_url=#{carouselUrl},redirect_url=#{redirectUrl},carousel_rank=#{carouselRank},is_deleted=#{isDeleted} WHERE carousel_id=#{carouselId}</update>
<delete id="deleteCarousel">DELETE FROM tb_newbee_mall_carousel WHERE carousel_id=#{id}</delete>
<select id="configs" resultMap="config">SELECT * FROM tb_newbee_mall_index_config ORDER BY config_type,config_rank DESC,config_id</select>
<select id="config" resultMap="config">SELECT * FROM tb_newbee_mall_index_config WHERE config_id=#{id}</select>
<insert id="insertConfig" useGeneratedKeys="true" keyProperty="configId">INSERT INTO tb_newbee_mall_index_config(config_name,config_type,goods_id,redirect_url,config_rank,is_deleted) VALUES(#{configName},#{configType},#{goodsId},#{redirectUrl},#{configRank},#{isDeleted})</insert>
<update id="updateConfig">UPDATE tb_newbee_mall_index_config SET config_name=#{configName},config_type=#{configType},goods_id=#{goodsId},redirect_url=#{redirectUrl},config_rank=#{configRank},is_deleted=#{isDeleted} WHERE config_id=#{configId}</update>
<delete id="deleteConfig">DELETE FROM tb_newbee_mall_index_config WHERE config_id=#{id}</delete>
</mapper>